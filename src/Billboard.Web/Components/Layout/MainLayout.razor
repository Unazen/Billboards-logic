@inherits LayoutComponentBase
@inject DemoUserSession Session
@inject NavigationManager Navigation

<div class="app-layout">
    <NavMenu />

    <div class="main-area">
        <Header />

        <main class="page-content">
            @if (IsAdminPath && !Session.IsAdministrator)
            {
                <section class="access-required">
                    <h2>Требуется демо-вход администратора</h2>
                    <p>Чтобы просматривать административные разделы, выберите учётную запись администратора.</p>
                    <a href="/login" class="access-required-link">Открыть вход →</a>
                </section>
            }
            else
            {
                @Body
            }
        </main>

        <StatusBar />
    </div>

    @code {
        protected override void OnInitialized()
        {
            if (!Session.HasSelectedAccount && !IsLoginPath)
                Navigation.NavigateTo("/login", replace: true);
        }

        private bool IsLoginPath =>
            new Uri(Navigation.Uri).AbsolutePath.Equals("/login", StringComparison.OrdinalIgnoreCase);

        private bool IsAdminPath =>
            new Uri(Navigation.Uri).AbsolutePath.StartsWith("/admin", StringComparison.OrdinalIgnoreCase);
    }
</div>
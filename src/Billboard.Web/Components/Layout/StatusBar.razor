@implements IDisposable
@inject AdminDemoStore Store

<footer class="status-bar">
	<div class="status-connection">
		<span class="status-dot"></span>
		Подключение активно
	</div>

	<div class="status-metrics">
		<span>Пользователей: <strong>@Store.Users.Count</strong></span>
		<span>Устройств: <strong>@Store.Devices.Count</strong></span>
		<span>Файлов: <strong>@Store.UploadedFilesCount</strong></span>
	</div>
</footer>

@code {
	protected override void OnInitialized()
	{
		Store.Changed += OnStoreChanged;
	}

	private void OnStoreChanged()
	{
		_ = InvokeAsync(StateHasChanged);
	}

	public void Dispose()
	{
		Store.Changed -= OnStoreChanged;
	}
}

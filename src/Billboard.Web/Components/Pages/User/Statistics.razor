@page "/statistics"

@inject BillboardApiClient Api

<PageTitle>Статистика показов | Billboard</PageTitle>

<div class="client-page">
    <div class="client-page-heading">
        <div>
            <h1>Статистика показов</h1>
            <p>Подтверждённые показы и расходы по рекламным размещениям</p>
        </div>
        <span class="client-count">Всего размещений: @Usage.Count</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="billing-message" role="alert">@ErrorMessage</div>
    }
    else if (IsLoading)
    {
        <div class="client-panel client-empty-state">Загрузка статистики…</div>
    }
    else
    {
        <div class="client-stat-grid client-stat-grid-three">
            <div class="client-stat-card">
                <span class="client-stat-icon blue">▷</span>
                <span class="client-stat-label">Всего показов</span>
                <strong>@Usage.Sum(item => item.Plays).ToString("N0", RussianCulture)</strong>
                <small>Подтверждённые события воспроизведения</small>
            </div>
            <div class="client-stat-card">
                <span class="client-stat-icon orange">$</span>
                <span class="client-stat-label">Расходы</span>
                <strong>@Usage.Sum(item => item.Spent).ToString("N2", RussianCulture) $</strong>
                <small>Фактические списания по размещениям</small>
            </div>
            <div class="client-stat-card">
                <span class="client-stat-icon violet">◷</span>
                <span class="client-stat-label">Зарезервировано</span>
                <strong>@Usage.Sum(item => item.Reserved).ToString("N2", RussianCulture) $</strong>
                <small>Средства в активных размещениях</small>
            </div>
        </div>

        <section class="client-panel">
            <div class="client-panel-heading">
                <div><h3>Статистика по размещениям</h3><p>Значения поступают из billing API</p></div>
            </div>
            @if (Usage.Count == 0)
            {
                <div class="client-empty-state">
                    <h2>Показов пока нет</h2>
                    <p>После запуска размещений и получения событий воспроизведения статистика появится здесь.</p>
                </div>
            }
            else
            {
                <div class="client-responsive-table">
                    <table class="client-table">
                        <thead><tr><th>Размещение</th><th>Билборд</th><th>Показы</th><th>Расходы</th><th>Резерв</th></tr></thead>
                        <tbody>
                            @foreach (var item in Usage)
                            {
                                <tr @key="item.PlacementId">
                                    <td><strong>@item.PlacementId</strong></td>
                                    <td>@item.BillboardId</td>
                                    <td>@item.Plays.ToString("N0", RussianCulture)</td>
                                    <td>@item.Spent.ToString("N2", RussianCulture) $</td>
                                    <td>@item.Reserved.ToString("N2", RussianCulture) $</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</div>

@code {
    private static readonly System.Globalization.CultureInfo RussianCulture =
        System.Globalization.CultureInfo.GetCultureInfo("ru-RU");

    private IReadOnlyList<Billboard.Application.Contracts.PlacementUsageDto> Usage { get; set; } = [];
    private string? ErrorMessage { get; set; }
    private bool IsLoading { get; set; } = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Usage = await Api.GetListAsync<Billboard.Application.Contracts.PlacementUsageDto>("api/v1/billing/usage");
        }
        catch (BillboardApiException exception)
        {
            ErrorMessage = exception.Message;
        }
        catch (HttpRequestException)
        {
            ErrorMessage = "Не удалось подключиться к API.";
        }
        finally
        {
            IsLoading = false;
        }
    }
}

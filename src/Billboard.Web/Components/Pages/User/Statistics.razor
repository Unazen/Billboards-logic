@page "/statistics"
@inject IClientPanelService Panel

<PageTitle>Статистика показов | Billboard</PageTitle>

<div class="client-page">
    <div class="client-page-heading">
        <div>
            <h1>Статистика показов</h1>
            <p>Результаты воспроизведения ваших рекламных материалов</p>
        </div>
        <span class="client-count">Текущий месяц</span>
    </div>

    <div class="client-demo-note">
        <span aria-hidden="true">ⓘ</span>
        Статистика демонстрационная. В реальной версии она будет формироваться по событиям воспроизведения устройств.
    </div>

    <div class="client-stat-grid client-stat-grid-three">
        <div class="client-stat-card">
            <span class="client-stat-icon blue">▷</span>
            <span class="client-stat-label">Всего показов</span>
            <strong>@PlaybackItems.Sum(item => item.Impressions).ToString("N0", RussianCulture)</strong>
            <small>За текущий месяц</small>
        </div>
        <div class="client-stat-card">
            <span class="client-stat-icon violet">◷</span>
            <span class="client-stat-label">Время трансляции</span>
            <strong>@FormatMinutes(PlaybackItems.Sum(item => item.MinutesPlayed))</strong>
            <small>Суммарно по всем материалам</small>
        </div>
        <div class="client-stat-card">
            <span class="client-stat-icon green">✓</span>
            <span class="client-stat-label">Среднее завершение</span>
            <strong>@AverageCompletion.ToString("F1", RussianCulture)%</strong>
            <small>Доля завершённых показов</small>
        </div>
    </div>

    <section class="client-panel">
        <div class="client-panel-heading">
            <div><h3>Показы по рекламным материалам</h3><p>Данные за текущий месяц</p></div>
        </div>
        <div class="client-responsive-table">
            <table class="client-table">
                <thead><tr><th>Материал</th><th>Показы</th><th>Время в эфире</th><th>Завершение</th></tr></thead>
                <tbody>
                    @foreach (var item in PlaybackItems)
                    {
                        <tr @key="item.Title">
                            <td><strong>@item.Title</strong></td>
                            <td>@item.Impressions.ToString("N0", RussianCulture)</td>
                            <td>@FormatMinutes(item.MinutesPlayed)</td>
                            <td>
                                <div class="client-progress-cell">
                                    <div class="client-progress"><span style="@($"width:{item.CompletionRate.ToString(System.Globalization.CultureInfo.InvariantCulture)}%")"></span></div>
                                    <small>@item.CompletionRate.ToString("F1", RussianCulture)%</small>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@code {
    private static readonly System.Globalization.CultureInfo RussianCulture =
        System.Globalization.CultureInfo.GetCultureInfo("ru-RU");

    private IReadOnlyList<PlaybackStatistic> PlaybackItems => Panel.GetPlaybackStatistics();
    private double AverageCompletion => PlaybackItems.Count == 0 ? 0 : PlaybackItems.Average(item => item.CompletionRate);

    private static string FormatMinutes(int minutes) =>
        $"{minutes / 60} ч {minutes % 60:D2} мин";
}

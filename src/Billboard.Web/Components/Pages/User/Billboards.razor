@page "/my-billboards"

@inject BillboardApiClient Api

<PageTitle>Мои билборды | Billboard</PageTitle>

<div class="client-page">
    <div class="client-page-heading">
        <div>
            <h1>Мои билборды</h1>
            <p>Состояние и местоположение устройств, доступных вашему аккаунту</p>
        </div>
        <span class="client-count">Устройств: @BillboardItems.Count</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="billing-message" role="alert">@ErrorMessage</div>
    }
    else if (IsLoading)
    {
        <div class="client-panel client-empty-state">Загрузка билбордов…</div>
    }
    else if (BillboardItems.Count == 0)
    {
        <section class="client-panel client-empty-state">
            <h2>Билбордов пока нет</h2>
            <p>Когда устройства будут доступны вашему аккаунту, они появятся здесь.</p>
        </section>
    }
    else
    {
        <section class="client-panel">
            <div class="client-responsive-table">
                <table class="client-table">
                    <thead>
                        <tr><th>Устройство</th><th>Местоположение</th><th>Состояние</th><th>Трансляция</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var device in BillboardItems)
                        {
                            <tr @key="device.Id">
                                <td><strong>@device.Name</strong><small>@device.Id</small></td>
                                <td>@device.Address</td>
                                <td><span class="client-status @(IsOnline(device.Status) ? "online" : "offline")"><i></i>@device.Status</span></td>
                                <td><a class="client-table-link" href="/streams">Открыть просмотр →</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@code {
    private IReadOnlyList<Billboard.Application.Contracts.BillboardDto> BillboardItems { get; set; } = [];
    private string? ErrorMessage { get; set; }
    private bool IsLoading { get; set; } = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            BillboardItems = await Api.GetListAsync<Billboard.Application.Contracts.BillboardDto>("api/v1/billboards?mine=true");
        }
        catch (BillboardApiException exception)
        {
            ErrorMessage = exception.Message;
        }
        catch (HttpRequestException)
        {
            ErrorMessage = "Не удалось подключиться к API.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private static bool IsOnline(string status) =>
        status.Equals("Online", StringComparison.OrdinalIgnoreCase) ||
        status.Equals("В сети", StringComparison.OrdinalIgnoreCase);
}

@page "/my-billboards"
@inject IClientPanelService Panel

<PageTitle>Мои билборды | Billboard</PageTitle>

<div class="client-page">
    <div class="client-page-heading">
        <div>
            <h1>Мои билборды</h1>
            <p>Состояние и местоположение устройств, закреплённых за вами</p>
        </div>
        <span class="client-count">Устройств: @BillboardItems.Count</span>
    </div>

    <div class="client-demo-note">
        <span aria-hidden="true">ⓘ</span>
        Список отфильтрован по текущему демо-пользователю: @Panel.UserName.
    </div>

    @if (BillboardItems.Count == 0)
    {
        <section class="client-panel client-empty-state">
            <h2>Билбордов пока нет</h2>
            <p>Когда устройства будут назначены вашему аккаунту, они появятся здесь.</p>
        </section>
    }
    else
    {
        <section class="client-panel">
            <div class="client-responsive-table">
                <table class="client-table">
                    <thead>
                        <tr><th>Устройство</th><th>Местоположение</th><th>Состояние</th><th>Трансляция</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var device in BillboardItems)
                        {
                            <tr @key="device.Id">
                                <td><strong>@device.Name</strong><small>Устройство #@device.Id</small></td>
                                <td>@device.Location</td>
                                <td><span class="client-status @(device.IsOnline ? "online" : "offline")"><i></i>@(device.IsOnline ? "В сети" : "Не в сети")</span></td>
                                <td><a class="client-table-link" href="/streams">Открыть просмотр →</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@code {
    private IReadOnlyList<BillboardDevice> BillboardItems => Panel.GetBillboards();
}

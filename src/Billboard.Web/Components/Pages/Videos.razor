
@page "/videos"

@using Microsoft.AspNetCore.Components.Forms
@using System.IO

<PageTitle>Медиатека</PageTitle>

<div class="videos-page">

    <div class="videos-header">
        <div>
            <h1>Медиатека</h1>
            <p>Управление рекламными видеороликами</p>
        </div>

        <div class="videos-header-info">
            <span class="storage-label">Медиафайлы</span>
            <span class="storage-value">@videos.Count файлов</span>
        </div>
    </div>

    <div class="video-stats">

        <div class="video-stat-card">
            <div class="stat-icon purple">▣</div>
            <div>
                <span>Всего видео</span>
                <strong>@videos.Count</strong>
            </div>
        </div>

        <div class="video-stat-card">
            <div class="stat-icon blue">↑</div>
            <div>
                <span>Ожидают загрузки</span>
                <strong>@videos.Count</strong>
            </div>
        </div>

        <div class="video-stat-card">
            <div class="stat-icon green">✓</div>
            <div>
                <span>Загружено</span>
                <strong>0</strong>
            </div>
        </div>

    </div>

    <div class="upload-section">

        <div class="section-heading">
            <div>
                <h2>Добавить видео</h2>
                <p>Выберите рекламные ролики с вашего устройства</p>
            </div>
        </div>

        <label class="upload-zone">

            <InputFile OnChange="OnFilesSelected"
                       multiple
                       accept=".mp4,.webm,.mov,.mkv"
                       class="upload-input" />

            <div class="upload-content">
                <div class="upload-icon">↑</div>

                <h3>Выберите видеофайлы</h3>

                <p>
                    Нажмите здесь, чтобы выбрать файлы
                </p>

                <span class="supported-formats">
                    Поддерживаемые форматы: MP4, WEBM, MOV, MKV
                </span>
            </div>

        </label>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="upload-message">@statusMessage</div>
        }

    </div>

    <div class="library-section">

        <div class="library-heading">
            <div>
                <h2>Мои видео</h2>
                <p>Список рекламных материалов</p>
            </div>

            <input class="video-search"
                   type="text"
                   placeholder="Поиск видео..."
                   @bind="searchText" />
        </div>

        @if (FilteredVideos.Any())
        {
            <div class="video-table-wrapper">

                <table class="video-table">

                    <thead>
                        <tr>
                            <th>Название</th>
                            <th>Размер</th>
                            <th>Дата добавления</th>
                            <th>Статус</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var video in FilteredVideos)
                        {
                            <tr @key="video.Id">

                                <td>
                                    <div class="video-name">
                                        <div class="video-file-icon">▶</div>
                                        <div>
                                            <strong>@video.Name</strong>
                                            <span>@video.Extension</span>
                                        </div>
                                    </div>
                                </td>

                                <td>@FormatSize(video.Size)</td>

                                <td>@video.AddedAt.ToString("dd.MM.yyyy HH:mm")</td>

                                <td>
                                    <span class="video-status">
                                        Ожидает загрузки
                                    </span>
                                </td>

                                <td>
                                    <button class="delete-button"
                                            title="Удалить из списка"
                                            @onclick="() => RemoveVideo(video.Id)">
                                        ✕
                                    </button>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-library">
                <div class="empty-icon">▣</div>

                <h3>
                    @(videos.Count == 0
                        ? "Медиатека пока пуста"
                        : "Видео не найдены")
                </h3>

                <p>
                    @(videos.Count == 0
                        ? "Добавьте рекламные ролики, чтобы они появились здесь."
                        : "Попробуйте изменить поисковый запрос.")
                </p>
            </div>
        }

        @if (videos.Count > 0)
        {
            <div class="upload-footer">
                <span>Подготовлено файлов: @videos.Count</span>

                <button class="clear-button"
                        @onclick="ClearVideos">
                    Очистить список
                </button>
            </div>
        }

    </div>

    <div class="api-notice">
        <strong>Информация</strong>
        <p>
            Сейчас файлы добавляются в интерфейс локально.
            Отправка на сервер хранения MinIO будет подключена
            после интеграции с API.
        </p>
    </div>

</div>

@code {

    private List<VideoItem> videos = new();

    private string searchText = "";

    private string statusMessage = "";

    private IEnumerable<VideoItem> FilteredVideos =>
        videos.Where(v =>
            v.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase));

    private void OnFilesSelected(InputFileChangeEventArgs e)
    {
        statusMessage = "";

        var selectedFiles = e.GetMultipleFiles();

        int added = 0;
        int rejected = 0;

        foreach (var file in selectedFiles)
        {
            string extension = Path.GetExtension(file.Name).ToLowerInvariant();

            string[] allowedExtensions =
            {
                ".mp4", ".webm", ".mov", ".mkv"
            };

            if (!allowedExtensions.Contains(extension))
            {
                rejected++;
                continue;
            }

            bool alreadyExists = videos.Any(v =>
                v.Name == file.Name && v.Size == file.Size);

            if (alreadyExists)
                continue;

            videos.Add(new VideoItem
            {
                Id = Guid.NewGuid(),
                Name = file.Name,
                Extension = extension,
                Size = file.Size,
                AddedAt = DateTime.Now
            });

            added++;
        }

        if (added > 0)
            statusMessage = $"Добавлено файлов: {added}";

        if (rejected > 0)
            statusMessage += $" Не поддерживается формат: {rejected} файлов.";

        if (added == 0 && rejected == 0)
            statusMessage = "Новые файлы не добавлены.";
    }

    private void RemoveVideo(Guid id)
    {
        videos.RemoveAll(v => v.Id == id);
    }

    private void ClearVideos()
    {
        videos.Clear();
        statusMessage = "Список очищен.";
    }

    private string FormatSize(long bytes)
    {
        double mb = bytes / 1024d / 1024d;

        if (mb >= 1024)
            return $"{mb / 1024:F2} ГБ";

        return $"{mb:F2} МБ";
    }

    private class VideoItem
    {
        public Guid Id { get; set; }

        public string Name { get; set; } = "";

        public string Extension { get; set; } = "";

        public long Size { get; set; }

        public DateTime AddedAt { get; set; }
    }
}

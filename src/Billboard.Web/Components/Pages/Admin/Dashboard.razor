@page "/admin"

@inject AdminDemoStore Store
@inject AdminLogDemoStore LogStore

<PageTitle>Администрирование | Billboard</PageTitle>

<div class="admin-page">
    <div class="admin-heading">
        <div>
            <h1>Панель администратора</h1>
            <p>Общее состояние системы и управление ресурсами</p>
        </div>
        <span class="admin-role">Администратор</span>
    </div>

    <div class="admin-stats">
        <div class="admin-stat-card">
            <span class="stat-icon">👥</span>
            <span class="stat-label">Пользователи</span>
            <strong>@Store.Users.Count</strong>
            <NavLink href="/admin/users">Управление пользователями →</NavLink>
        </div>

        <div class="admin-stat-card">
            <span class="stat-icon">📺</span>
            <span class="stat-label">Билборды</span>
            <strong>@Store.Devices.Count</strong>
            <NavLink href="/admin/billboards">Управление билбордами →</NavLink>
        </div>

        <div class="admin-stat-card">
            <span class="stat-icon">🟢</span>
            <span class="stat-label">В сети</span>
            <strong>@Store.Devices.Count(d => d.IsOnline)</strong>
            <span class="stat-description">Устройств работают</span>
        </div>

        <div class="admin-stat-card">
            <span class="stat-icon">🔴</span>
            <span class="stat-label">Не в сети</span>
            <strong>@Store.Devices.Count(d => !d.IsOnline)</strong>
            <span class="stat-description">Требуют проверки</span>
        </div>
    </div>

    <section class="admin-section">
        <div class="section-heading">
            <div>
                <h2>Последние устройства</h2>
                <p>Текущее состояние билбордов системы</p>
            </div>

            <NavLink href="/admin/billboards" class="admin-link">
                Все устройства →
            </NavLink>
        </div>

        <div class="admin-table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Устройство</th>
                        <th>Местоположение</th>
                        <th>Владелец</th>
                        <th>Состояние</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var device in Store.Devices.Take(5))
                    {
                        var owner = Store.Users.FirstOrDefault(
                            u => u.Id == device.OwnerId);

                        <tr>
                            <td>@device.Name</td>
                            <td>@device.Location</td>
                            <td>@(owner?.Name ?? "Неизвестен")</td>
                            <td>
                                @if (device.IsOnline)
                                {
                                    <span class="status online">В сети</span>
                                }
                                else
                                {
                                    <span class="status offline">Не в сети</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="admin-section">
        <div class="section-heading">
            <div>
                <h2>Последние события</h2>
                <p>Недавние системные операции и предупреждения</p>
            </div>

            <NavLink href="/admin/logs" class="admin-link">
                Системные логи →
            </NavLink>
        </div>

        <div class="admin-event-list">
            @foreach (var entry in LogStore.GetLogs().Take(3))
            {
                <div class="admin-event-row" @key="entry.Timestamp">
                    <span class="admin-event-indicator @EventClass(entry.Level)"></span>
                    <div class="admin-event-content">
                        <strong>@entry.Action</strong>
                        <small>@entry.Target · @entry.Actor</small>
                    </div>
                    <time datetime="@entry.Timestamp.ToString("O")">@entry.Timestamp.ToString("HH:mm")</time>
                </div>
            }
        </div>
    </section>
</div>

@code {
    private static string EventClass(string level) => level switch
    {
        "Ошибка" => "error",
        "Предупреждение" => "warning",
        _ => "info"
    };
}

@page "/admin/users"

@inject BillboardApiClient Api

<PageTitle>Пользователи | Billboard</PageTitle>

<div class="management-page">
    <div class="management-heading">
        <div><h1>Пользователи</h1><p>Управление учётными записями системы</p></div>
        <span class="management-count">Всего: @UserItems.Count</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <p class="form-message" role="status">@Message</p>
    }

    <section class="management-card">
        <h2>Добавить пользователя</h2>
        <div class="add-form">
            <input @bind="DisplayName" placeholder="Имя пользователя" maxlength="100" />
            <input @bind="Email" type="email" placeholder="Электронная почта" />
            <input @bind="Password" type="password" placeholder="Пароль (не менее 6 символов)" />
            <select @bind="Role"><option value="Client">Клиент</option><option value="Admin">Администратор</option></select>
            <button class="primary-button" @onclick="CreateUserAsync" disabled="@IsBusy">+ Добавить</button>
        </div>
    </section>

    <section class="management-card">
        <h2>Список пользователей</h2>
        @if (IsLoading)
        {
            <p>Загрузка пользователей…</p>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <p class="form-message" role="alert">@ErrorMessage</p>
        }
        else
        {
            <div class="table-wrapper">
                <table class="management-table">
                    <thead><tr><th>Имя</th><th>Электронная почта</th><th>Роль</th><th>Статус</th><th>Создан</th><th>Действия</th></tr></thead>
                    <tbody>
                        @foreach (var user in UserItems)
                        {
                            <tr @key="user.Id">
                                <td>@user.DisplayName</td>
                                <td>@user.Email</td>
                                <td>@string.Join(", ", user.Roles)</td>
                                <td>@(user.IsActive ? "Активен" : "Заблокирован")</td>
                                <td>@user.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                                <td>
                                    <button class="action-button" @onclick="() => SetActiveAsync(user)" disabled="@IsBusy">@(user.IsActive ? "Заблокировать" : "Активировать")</button>
                                    <button class="delete-button" @onclick="() => DeleteUserAsync(user)" disabled="@IsBusy">Удалить</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@code {
    private IReadOnlyList<Billboard.Application.Contracts.AdminUserDto> UserItems { get; set; } = [];
    private string DisplayName { get; set; } = string.Empty;
    private string Email { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
    private string Role { get; set; } = "Client";
    private string? Message { get; set; }
    private string? ErrorMessage { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool IsBusy { get; set; }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task CreateUserAsync()
    {
        IsBusy = true;
        Message = null;
        ErrorMessage = null;
        try
        {
            var user = await Api.PostAsync<Billboard.Application.Contracts.AdminUserDto>(
                "api/v1/admin/users",
                new Billboard.Application.Contracts.CreateUserRequest(Email.Trim(), Password, DisplayName.Trim(), Role));
            Message = $"Пользователь {user.Email} создан.";
            DisplayName = Email = Password = string.Empty;
            await LoadAsync();
        }
        catch (BillboardApiException exception)
        {
            ErrorMessage = exception.Message;
        }
        catch (HttpRequestException)
        {
            ErrorMessage = "Не удалось подключиться к API.";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task SetActiveAsync(Billboard.Application.Contracts.AdminUserDto user)
    {
        await RunActionAsync(async () =>
        {
            await Api.PatchAsync<Billboard.Application.Contracts.AdminUserDto>(
                $"api/v1/admin/users/{user.Id}/active",
                new Billboard.Application.Contracts.SetUserActiveRequest(!user.IsActive));
        });
    }

    private async Task DeleteUserAsync(Billboard.Application.Contracts.AdminUserDto user)
    {
        await RunActionAsync(async () => await Api.DeleteAsync($"api/v1/admin/users/{user.Id}"));
        if (ErrorMessage is null)
            Message = $"Пользователь {user.Email} удалён.";
    }

    private async Task RunActionAsync(Func<Task> action)
    {
        IsBusy = true;
        Message = null;
        ErrorMessage = null;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (BillboardApiException exception)
        {
            ErrorMessage = exception.Message;
        }
        catch (HttpRequestException)
        {
            ErrorMessage = "Не удалось подключиться к API.";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            UserItems = await Api.GetListAsync<Billboard.Application.Contracts.AdminUserDto>("api/v1/admin/users?skip=0&take=100");
            ErrorMessage = null;
        }
        catch (BillboardApiException exception)
        {
            ErrorMessage = exception.Message;
        }
        catch (HttpRequestException)
        {
            ErrorMessage = "Не удалось подключиться к API.";
        }
        finally
        {
            IsLoading = false;
        }
    }
}

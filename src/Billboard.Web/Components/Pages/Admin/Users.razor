
@page "/admin/users"

@inject AdminDemoStore Store

<PageTitle>Пользователи | Billboard</PageTitle>

<div class="management-page">
    <div class="management-heading">
        <div>
            <h1>Пользователи</h1>
            <p>Управление учётными записями системы</p>
        </div>

        <span class="management-count">
            Всего: @Store.Users.Count
        </span>
    </div>

    <section class="management-card">
        <h2>Добавить пользователя</h2>

        <div class="add-form">
            <input
                @bind="newName"
                placeholder="Имя пользователя" />

            <input
                @bind="newEmail"
                type="email"
                placeholder="Электронная почта" />

            <button class="primary-button" @onclick="AddUser">
                + Добавить
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <p class="form-message">@message</p>
        }
    </section>

    <section class="management-card">
        <h2>Список пользователей</h2>

        <div class="table-wrapper">
            <table class="management-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Имя</th>
                        <th>Электронная почта</th>
                        <th>Устройства</th>
                        <th>Действия</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var user in Store.Users)
                    {
                        <tr>
                            <td>@user.Id</td>
                            <td>@user.Name</td>
                            <td>@user.Email</td>
                            <td>
                                @Store.Devices.Count(d => d.OwnerId == user.Id)
                            </td>
                            <td>
                                <button
                                    class="delete-button"
                                    @onclick="() => RemoveUser(user.Id)">
                                    Удалить
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@code {
    private string newName = "";
    private string newEmail = "";
    private string message = "";

    private void AddUser()
    {
        if (string.IsNullOrWhiteSpace(newName) ||
            string.IsNullOrWhiteSpace(newEmail))
        {
            message = "Заполните все поля.";
            return;
        }

        Store.AddUser(newName.Trim(), newEmail.Trim());

        newName = "";
        newEmail = "";
        message = "Пользователь успешно добавлен.";
    }

    private void RemoveUser(int id)
    {
        bool removed = Store.RemoveUser(id);

        message = removed
            ? "Пользователь удалён."
            : "Нельзя удалить пользователя: сначала удалите его устройства.";
    }
}

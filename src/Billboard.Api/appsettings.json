{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=billboard;Username=billboard;Password=change_me"
  },
  "Storage": {
    "Provider": "Minio",
    "Endpoint": "localhost:9000",
    "AccessKey": "minio_change_me",
    "SecretKey": "minio_change_me_secret",
    "Bucket": "billboard-videos",
    "UseSsl": false,
    "LocalPath": "./storage-data"
  },
  "Media": {
    "FfprobePath": "ffprobe",
    "FfmpegPath": "ffmpeg",
    "RequireProbe": true,
    "AllowPrivateUrlImport": false,
    "ImportTimeoutSeconds": 300,
    "DownloadUrlTtlMinutes": 15,
    "PublicBaseUrl": "http://localhost:8080"
  }
}

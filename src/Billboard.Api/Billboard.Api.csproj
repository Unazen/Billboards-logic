      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Billboard.Application\Billboard.Application.csproj" />
    <ProjectReference Include="..\Billboard.Infrastructure\Billboard.Infrastructure.csproj" />
  </ItemGroup>

</Project>

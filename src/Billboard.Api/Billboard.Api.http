@host = http://localhost:8080
@clientToken = PASTE_ACCESS_TOKEN
@adminToken = PASTE_ADMIN_ACCESS_TOKEN
@billboardId = PASTE_BILLBOARD_ID
@groupId = PASTE_GROUP_ID
@userId = PASTE_USER_ID
@deviceToken = PASTE_DEVICE_TOKEN
@videoId = PASTE_VIDEO_ID
@placementId = PASTE_PLACEMENT_ID

### Регистрация клиента
POST {{host}}/api/v1/account/register
Content-Type: application/json

{
  "email": "client@example.com",
  "password": "Client_123",
  "displayName": "Клиент"
}

### Вход (в ответе accessToken)
POST {{host}}/api/v1/account/login
Content-Type: application/json

{
  "email": "client@example.com",
  "password": "Client_123"
}

### Вход администратора (создаётся из SEED_ADMIN_*)
POST {{host}}/api/v1/account/login
Content-Type: application/json

{
  "email": "admin@billboards.local",
  "password": "Change_me_123"
}

### Кто я и мой тариф
GET {{host}}/api/v1/account/me
Authorization: Bearer {{clientToken}}

### Тарифы
GET {{host}}/api/v1/tariffs

### Создать билборд (Admin) — в ответе deviceToken
POST {{host}}/api/v1/admin/billboards
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Билборд у вокзала",
  "address": "г. Минск, ул. Тестовая, 1",
  "capacityBytes": 34359738368,
  "advertCapacitySecondsPerHour": 1800,
  "pricePerPlay": 0.05,
  "timeZoneId": "Europe/Minsk"
}

### Каталог билбордов
GET {{host}}/api/v1/billboards
Authorization: Bearer {{clientToken}}

### Создать группу билбордов (Admin)
POST {{host}}/api/v1/admin/billboard-groups
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Центр"
}

### Добавить билборды в группу (Admin)
POST {{host}}/api/v1/admin/billboard-groups/{{groupId}}/billboards
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "billboardIds": ["{{billboardId}}"]
}

### Группы билбордов (любой авторизованный)
GET {{host}}/api/v1/billboard-groups
Authorization: Bearer {{clientToken}}

### Мои билборды (владение или аренда)
GET {{host}}/api/v1/billboards?mine=true
Authorization: Bearer {{clientToken}}

### Мои группы
GET {{host}}/api/v1/billboard-groups?mine=true
Authorization: Bearer {{clientToken}}

### Групповое назначение: проверка всех устройств
POST {{host}}/api/v1/placement-groups/validate
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{
  "billboardIds": ["{{billboardId}}"],
  "template": {
    "videoAssetId": "{{videoId}}",
    "startDate": "2026-11-10",
    "endDate": "2026-11-14",
    "daysOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    "startTime": "09:00:00",
    "endTime": "18:00:00",
    "minimumPlaysPerHour": 6,
    "videoDurationSeconds": 15
  }
}

### Групповое назначение: черновики (всё или ничего)
POST {{host}}/api/v1/placement-groups/drafts
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{
  "billboardIds": ["{{billboardId}}"],
  "template": {
    "videoAssetId": "{{videoId}}",
    "startDate": "2026-11-10",
    "endDate": "2026-11-14",
    "daysOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    "startTime": "09:00:00",
    "endTime": "18:00:00",
    "minimumPlaysPerHour": 6,
    "videoDurationSeconds": 15
  }
}

### Создать пользователя (Admin)
POST {{host}}/api/v1/admin/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "email": "new-client@example.com",
  "password": "Client_123",
  "displayName": "Новый клиент",
  "role": "Client"
}

### Удалить пользователя (Admin)
DELETE {{host}}/api/v1/admin/users/{{userId}}
Authorization: Bearer {{adminToken}}

### Шаг 1: создать загрузку видео
POST {{host}}/api/v1/videos/uploads
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{
  "fileName": "ad.mp4",
  "contentType": "video/mp4",
  "sizeBytes": 2048
}

### Шаг 2: загрузить файл (тело — сам файл)
PUT {{host}}/api/v1/videos/{{videoId}}/content
Authorization: Bearer {{clientToken}}
Content-Type: video/mp4

< ./ad.mp4

### Импорт по ссылке
POST {{host}}/api/v1/videos/import-url
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{
  "url": "https://example.com/ad.mp4"
}

### Медиатека
GET {{host}}/api/v1/videos
Authorization: Bearer {{clientToken}}

### Пополнить баланс (идемпотентно)
POST {{host}}/api/v1/billing/top-ups
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{
  "amount": 20,
  "idempotencyKey": "demo-topup-1"
}

### Баланс
GET {{host}}/api/v1/billing/wallet
Authorization: Bearer {{clientToken}}

### Создать размещение
POST {{host}}/api/v1/placements
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{
  "videoAssetId": "{{videoId}}",
  "billboardId": "{{billboardId}}",
  "startAt": "2026-11-02T00:00:00Z",
  "endAt": "2026-11-30T00:00:00Z",
  "daysOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
  "startTimeOfDay": "09:00:00",
  "endTimeOfDay": "18:00:00",
  "minimumPlaysPerHour": 6
}

### Проверка без сохранения
POST {{host}}/api/v1/placements/validate
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{
  "videoAssetId": "{{videoId}}",
  "billboardId": "{{billboardId}}",
  "startAt": "2026-11-02T00:00:00Z",
  "endAt": "2026-11-30T00:00:00Z",
  "daysOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
  "startTimeOfDay": "09:00:00",
  "endTimeOfDay": "18:00:00",
  "minimumPlaysPerHour": 6
}

### Публикация: резерв бюджета
POST {{host}}/api/v1/placements/{{placementId}}/publish?billboardCount=1
Authorization: Bearer {{clientToken}}

### Манифест устройства
GET {{host}}/api/v1/devices/{{billboardId}}/manifest
X-Device-Token: {{deviceToken}}

### Отчёт о кэше
POST {{host}}/api/v1/devices/{{billboardId}}/cache-reports
X-Device-Token: {{deviceToken}}
Content-Type: application/json

{
  "items": [
    { "videoAssetId": "{{videoId}}", "sizeBytes": 2048, "downloadStatus": "Ready", "integrityVerified": true }
  ]
}

### События показов (повтор не списывает деньги)
POST {{host}}/api/v1/devices/{{billboardId}}/playback-events
X-Device-Token: {{deviceToken}}
Content-Type: application/json

{
  "events": [
    {
      "idempotencyKey": "evt-1",
      "placementId": "{{placementId}}",
      "videoAssetId": "{{videoId}}",
      "startedAt": "2026-11-06T18:00:00Z",
      "durationSeconds": 15,
      "result": "Completed"
    }
  ]
}

### Затраты по размещениям
GET {{host}}/api/v1/billing/usage
Authorization: Bearer {{clientToken}}

### Доход владельца (Admin)
GET {{host}}/api/v1/billing/earnings
Authorization: Bearer {{adminToken}}

### Отмена: возврат резерва
POST {{host}}/api/v1/placements/{{placementId}}/cancel
Authorization: Bearer {{clientToken}}
